{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test src/services/*.test.ts",
    "test:history-integration": "MONGODB_LIVE_TEST=1 tsx --test src/services/mongo-live.test.ts src/services/mongo-live-guards.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@clerk/shared": "^4.44.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "axe-core": "^4.14.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "ipaddr.js": "^2.5.0",
    "mongodb": "^7.8.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "playwright": "^1.65.0",
    "sanitize-html": "^2.18.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
